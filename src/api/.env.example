NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Path to the SQLite database built by db/build.sh. Defaults to db/kpx.db at the
# repository root, resolved from the API's own location. The API never creates
# this file — a path that does not exist is a startup error, not an empty database.
DATABASE_PATH=

# TODO(auth): authentication is still the X-Acting-User header stub, which trusts
# a value anyone can set. The app refuses to start unless this is exactly "true".
# Removed in Phase J along with the stub itself.
ALLOW_STUB_AUTH=true
